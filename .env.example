TASKFLOW_PUBLIC_URL=https://taskflow.carlosrevert.es
NODE_ENV=development
WEB_PORT=10700
API_PORT=10701
POSTGRES_PORT=10710
REDIS_PORT=10720

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
DATABASE_URL=postgresql://taskflow:taskflow@db:5432/taskflow
REDIS_URL=redis://redis:6379/0

ACCOUNTS_BASE_URL=https://cuenta.carlosrevert.es
ACCOUNTS_TIMEOUT_SECONDS=2
ACCOUNTS_TASKFLOW_SERVICE_KEY=
ACCOUNTS_QUOTA_MODE=accounts

AI_PROVIDER=fake
AI_STT_PROVIDER=
AI_LLM_PROVIDER=
AI_MAX_AUDIO_SECONDS=300
AI_MAX_AUDIO_BYTES=25000000
AI_MAX_TRANSCRIPT_CHARS=100000
AI_AUDIO_TEMP_DIR=/tmp/taskflow-audio
AI_STT_TASK_MAX_RETRIES=2
AI_LLM_MAX_RETRIES=1
AI_MAX_LLM_RESPONSE_CHARS=20000

ACCOUNTS_APPLICATION_SLUG=taskflow

STORAGE_MODE=cloud
LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_STT=whisper-1
OPENAI_TEMPERATURE=0.2


GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2