{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskflow.carlosrevert.es/schemas/task-extraction.schema.json",
  "title": "TaskFlow validated task extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/task"}
    },
    "source": {"$ref": "#/$defs/source"}
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "classification_hint", "confidence"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "list_id": {
          "oneOf": [
            {"$ref": "#/$defs/uuid"},
            {"type": "null"}
          ]
        },
        "classification_hint": {
          "enum": ["explicit", "current", "semantic", "inbox", "ambiguous"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "voice_transcript"},
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        }
      }
    }
  }
}